    // ============================================================
    // PRODUCT RENDERING
    // ============================================================
    function renderProducts() {
      const search = els.productSearch.value.trim().toLowerCase();
      const category = els.categoryFilter.value;
      const sort = els.sortSelect.value;

      let products = STORE_CONFIG.products.filter(product => {
        const matchesCategory = category === "All" || product.category === category;
        const text = `${product.name} ${product.category} ${product.description}`.toLowerCase();
        const matchesSearch = !search || text.includes(search);
        return matchesCategory && matchesSearch;
      });

      products = sortProducts(products, sort);

      if (!products.length) {
        els.productGrid.innerHTML = `<div class="cart-empty" style="grid-column: 1 / -1;">No products matched that search.</div>`;
        return;
      }

      els.productGrid.innerHTML = products.map(product => renderProductCard(product)).join("");

      products.forEach(product => {
        const card = document.querySelector(`[data-card="${product.id}"]`);
        if (!card) return;

        card.querySelector("[data-add]").addEventListener("click", () => addProductFromCard(product.id));
        card.querySelector("[data-details]").addEventListener("click", () => openProductModal(product.id));
        card.querySelector("[data-qty-minus]").addEventListener("click", () => updateCardQty(product.id, -1));
        card.querySelector("[data-qty-plus]").addEventListener("click", () => updateCardQty(product.id, 1));
      });
    }

    function sortProducts(products, sort) {
      const copy = [...products];
      if (sort === "price-asc") return copy.sort((a, b) => a.price - b.price);
      if (sort === "price-desc") return copy.sort((a, b) => b.price - a.price);
      if (sort === "stock-desc") return copy.sort((a, b) => b.stock - a.stock);
      return copy.sort((a, b) => Number(b.featured) - Number(a.featured));
    }

    function renderProductCard(product) {
      const variantControls = renderVariantControls(product, product.id);
      const stockText = product.stock > 0 ? `${product.stock} in stock` : "Out of stock";
      const stockClass = product.stock > 0 ? "stock-badge" : "stock-badge";
      const disabled = product.stock <= 0 ? "disabled" : "";

      return `
        <article class="product-card" data-card="${product.id}">
          <div class="product-media">
            ${product.image ? `<img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" loading="lazy" />` : `<div class="placeholder-orb">${escapeHtml(product.category)}</div>`}
            <div class="${stockClass}">${escapeHtml(stockText)}</div>
            ${product.featured ? `<div class="feature-badge">Featured</div>` : ""}
          </div>
          <div class="product-body">
            <div class="product-top">
              <h3 class="product-title">${escapeHtml(product.name)}</h3>
              <div class="price">${formatMoney(product.price)}</div>
            </div>
            <p class="product-desc">${escapeHtml(product.description)}</p>
            ${variantControls}
            <div class="qty-row">
              <span style="color: var(--muted); font-size: .9rem;">Quantity</span>
              <div class="qty-control" aria-label="Quantity selector">
                <button type="button" data-qty-minus>-</button>
                <span data-card-qty="${product.id}">1</span>
                <button type="button" data-qty-plus>+</button>
              </div>
            </div>
            <div class="product-actions">
              <button class="primary-btn" type="button" data-add ${disabled}>Add to cart</button>
              <button class="ghost-btn" type="button" data-details>Details</button>
            </div>
          </div>
        </article>
      `;
    }

    function renderVariantControls(product, idPrefix) {
      if (!product.variants || !Object.keys(product.variants).length) return "";

      return Object.entries(product.variants).map(([name, options]) => `
        <div class="field" style="margin-top: 10px;">
          <label for="${idPrefix}-${slugify(name)}">${escapeHtml(name)}</label>
          <select id="${idPrefix}-${slugify(name)}" class="select" data-variant-name="${escapeHtml(name)}">
            ${options.map(option => `<option value="${escapeHtml(option)}">${escapeHtml(option)}</option>`).join("")}
          </select>
        </div>
      `).join("");
    }

    function updateCardQty(productId, delta) {
      const el = document.querySelector(`[data-card-qty="${productId}"]`);
      if (!el) return;
      const product = getProduct(productId);
      const next = Math.max(1, Math.min(product.stock, Number(el.textContent) + delta));
      el.textContent = String(next);
    }

    function addProductFromCard(productId) {
      const card = document.querySelector(`[data-card="${productId}"]`);
      const qty = Number(card.querySelector(`[data-card-qty="${productId}"]`).textContent || 1);
      const variantSelects = [...card.querySelectorAll("[data-variant-name]")];
      const variants = Object.fromEntries(variantSelects.map(select => [select.dataset.variantName, select.value]));
      addToCart(productId, qty, variants);
    }

