      });
      body.querySelector("[data-modal-plus]").addEventListener("click", () => {
        qtyEl.textContent = String(Math.min(product.stock, Number(qtyEl.textContent) + 1));
      });
      body.querySelector("[data-modal-add]").addEventListener("click", () => {
        const variants = Object.fromEntries([...body.querySelectorAll("[data-variant-name]")].map(select => [select.dataset.variantName, select.value]));
        addToCart(product.id, Number(qtyEl.textContent), variants);
        closeProductModal();
      });

      els.productModal.classList.add("active");
      els.productModal.setAttribute("aria-hidden", "false");
    }

    function closeProductModal() {
      els.productModal.classList.remove("active");
      els.productModal.setAttribute("aria-hidden", "true");
    }

    // ============================================================
    // CART
    // ============================================================
    function addToCart(productId, qty = 1, variants = {}) {
      const product = getProduct(productId);
      if (!product || product.stock <= 0) return;

      const safeQty = Math.max(1, Math.min(qty, product.stock));
      const key = cartItemKey(productId, variants);
      const existing = cart.find(item => item.key === key);
      const existingQty = existing ? existing.qty : 0;
      const nextQty = Math.min(product.stock, existingQty + safeQty);

      if (existing) {
        existing.qty = nextQty;
      } else {
        cart.push({ key, productId, qty: nextQty, variants });
      }

      saveCart();
      renderCart();
      showToast("Item added. Cart updated.");
    }

    function removeFromCart(key) {
      cart = cart.filter(item => item.key !== key);
      saveCart();
      renderCart();
    }

    function updateCartQty(key, delta) {
      const item = cart.find(entry => entry.key === key);
      if (!item) return;
      const product = getProduct(item.productId);
      item.qty = Math.max(1, Math.min(product.stock, item.qty + delta));
      saveCart();
      renderCart();
    }

    function clearCart() {
      cart = [];
      saveCart();
      renderCart();
      showToast("Cart cleared.");
    }

    function renderCart() {
      const subtotal = getSubtotal();
      const shipping = getSelectedShippingCost(subtotal);
      const total = subtotal + shipping;

      els.cartCount.textContent = String(cart.reduce((sum, item) => sum + item.qty, 0));
      els.cartSubtotal.textContent = formatMoney(subtotal);
      els.cartShipping.textContent = formatMoney(shipping);
      els.cartTotal.textContent = formatMoney(total);
      els.checkoutSubtotal.textContent = formatMoney(subtotal);
      els.checkoutShipping.textContent = formatMoney(shipping);
      els.checkoutTotal.textContent = formatMoney(total);
      updateBtcEstimate();

      if (!cart.length) {
        els.cartItems.innerHTML = `<div class="cart-empty">Cart empty. Select your item to begin.</div>`;
        els.checkoutItems.innerHTML = `<div class="cart-empty">No items selected yet.</div>`;
        return;
      }

      els.cartItems.innerHTML = cart.map(renderCartItem).join("");
      els.checkoutItems.innerHTML = cart.map(renderSummaryItem).join("");

      cart.forEach(item => {
        const row = document.querySelector(`[data-cart-item="${cssEscape(item.key)}"]`);
        if (!row) return;
        row.querySelector("[data-cart-minus]").addEventListener("click", () => updateCartQty(item.key, -1));
        row.querySelector("[data-cart-plus]").addEventListener("click", () => updateCartQty(item.key, 1));
        row.querySelector("[data-cart-remove]").addEventListener("click", () => removeFromCart(item.key));
      });
    }

    function renderCartItem(item) {
      const product = getProduct(item.productId);
      const variantText = formatVariants(item.variants);
      return `
        <div class="cart-item" data-cart-item="${escapeHtml(item.key)}">
          <div class="cart-thumb">
            ${product.image ? `<img src="${escapeHtml(product.image)}" alt="${escapeHtml(product.name)}" />` : "ITEM"}
          </div>
          <div class="cart-meta">
            <h4>${escapeHtml(product.name)}</h4>
            <p>${escapeHtml(variantText || product.category)}</p>
            <div class="cart-line">
              <div class="qty-control">
                <button type="button" data-cart-minus>-</button>
                <span>${item.qty}</span>
                <button type="button" data-cart-plus>+</button>
              </div>
              <strong>${formatMoney(product.price * item.qty)}</strong>
            </div>
            <button class="small-btn" type="button" data-cart-remove style="margin-top: 10px;">Remove</button>
          </div>
        </div>
      `;
    }

    function renderSummaryItem(item) {
      const product = getProduct(item.productId);
      const variantText = formatVariants(item.variants);
      return `
        <div class="summary-product">
          <span><strong>${escapeHtml(product.name)}</strong><br><small>${escapeHtml(variantText || "Standard")} × ${item.qty}</small></span>
          <strong>${formatMoney(product.price * item.qty)}</strong>
        </div>
      `;
    }

    function openCartDrawer() {
      els.cartDrawer.classList.add("active");
      els.cartDrawer.setAttribute("aria-hidden", "false");
    }

    function closeCartDrawer() {
      els.cartDrawer.classList.remove("active");
      els.cartDrawer.setAttribute("aria-hidden", "true");
    }

    function loadCart() {
      try {
        const parsed = JSON.parse(localStorage.getItem(CART_KEY) || "[]");
        return Array.isArray(parsed) ? parsed : [];
      } catch {
        return [];
      }
    }

    function saveCart() {
      localStorage.setItem(CART_KEY, JSON.stringify(cart));
    }

    // ============================================================
    // CHECKOUT
    // ============================================================
    function handleCheckout(event) {
      event.preventDefault();

      if (!cart.length) {
        showToast("Add at least one item before checkout.");
        openCartDrawer();
        return;
      }

      if (!els.checkoutForm.reportValidity()) {
        showToast("Complete the required checkout fields.");
        return;
      }

      const formData = new FormData(els.checkoutForm);
      const data = Object.fromEntries(formData.entries());
      const orderNumber = generateOrderNumber();
      const subtotal = getSubtotal();
      const shipping = getSelectedShippingCost(subtotal);
      const total = subtotal + shipping;
      const btcEstimate = total / STORE_CONFIG.estimatedBtcRate;
      const items = cart.map(item => {
        const product = getProduct(item.productId);
        return {
          name: product.name,
          qty: item.qty,
          variants: item.variants,
          unitPrice: product.price,
          lineTotal: product.price * item.qty
        };
      });

      activeReceipt = buildReceipt({
        orderNumber,
        data,
        items,
        subtotal,
        shipping,
        total,
        btcEstimate
      });

      els.receiptBox.textContent = activeReceipt;
      els.confirmationPanel.classList.add("active");
      els.confirmationPanel.scrollIntoView({ behavior: "smooth", block: "start" });
      showToast("Order created. Payment pending.");
    }

    function buildReceipt({ orderNumber, data, items, subtotal, shipping, total, btcEstimate }) {
      const itemLines = items.map(item => {
        const variants = formatVariants(item.variants) || "Standard";
        return `- ${item.name} (${variants}) × ${item.qty} @ ${formatMoney(item.unitPrice)} = ${formatMoney(item.lineTotal)}`;
      }).join("\n");

      return `${STORE_CONFIG.shopName}\nORDER CREATED — AWAITING BTC PAYMENT\n\nOrder number: ${orderNumber}\nPayment status: Awaiting BTC Payment\n\nCustomer\nName: ${data.fullName}\nEmail: ${data.email}\nPhone: ${data.phone || "Not provided"}\n\nShipping\n${data.address1}\n${data.address2 ? data.address2 + "\n" : ""}${data.city}\n${data.county ? data.county + "\n" : ""}${data.postcode}\n${data.country}\nShipping method: ${shippingLabel(data.shippingMethod)}\nOrder notes: ${data.orderNotes || "None"}\n\nProducts\n${itemLines}\n\nTotals\nSubtotal: ${formatMoney(subtotal)}\nShipping: ${formatMoney(shipping)}\nFinal total: ${formatMoney(total)}\nEstimated BTC: ${btcEstimate.toFixed(8)} BTC\n\nBitcoin payment instructions\nSend the exact order total to:\n${STORE_CONFIG.btcAddress}\n\nBTC payments are irreversible. Include your order number in your email confirmation or order notes if required. Your order will be processed after payment is confirmed.\n\nNotice\nOrders are accepted only once the products are confirmed paid for in full.`;
    }

    function downloadReceipt() {
      if (!activeReceipt) {
        showToast("Create an order first.");
        return;
      }
      const blob = new Blob([activeReceipt], { type: "text/plain;charset=utf-8" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = `${STORE_CONFIG.shopName.replace(/\s+/g, "-").toLowerCase()}-receipt.txt`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
      showToast("Receipt downloaded.");
    }

    function updateShippingHint() {
      const method = els.shippingMethod.value;
      const shipping = STORE_CONFIG.shipping[method];
      if (!shipping) return;
      els.shippingHint.textContent = `${shipping.description} Free shipping over ${formatMoney(STORE_CONFIG.shipping.freeShippingOver)} applies to standard/express orders. ${method === "international" ? STORE_CONFIG.shipping.internationalRules : ""}`;
    }

    function maybeSwitchInternationalShipping() {
      const country = els.country.value;
      if (country && country !== "United Kingdom") {
        els.shippingMethod.value = "international";
      }
      updateShippingHint();
    }

    function getSelectedShippingCost(subtotal) {
      if (!cart.length) return 0;
      const method = els.shippingMethod.value || "standard";
      if (subtotal >= STORE_CONFIG.shipping.freeShippingOver && method !== "international") return 0;
      return STORE_CONFIG.shipping[method]?.price ?? STORE_CONFIG.shipping.standard.price;
    }

    function shippingLabel(key) {
      return STORE_CONFIG.shipping[key]?.label || STORE_CONFIG.shipping.standard.label;
    }

    function updateBtcEstimate() {
  const subtotal = getSubtotal();
  const total = subtotal + getSelectedShippingCost(subtotal);

  const rate = liveBtcGbpRate || STORE_CONFIG.fallbackBtcGbpRate;
  const btc = total / rate;

  const sourceText = liveBtcGbpRate
    ? `Live BTC/GBP rate loaded at ${liveBtcUpdatedAt.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" })}.`
    : "Live BTC/GBP price unavailable. Fallback estimate is being used.";

  els.btcEstimate.innerHTML = `
    BTC amount due: <strong>${btc.toFixed(8)} BTC</strong><br>
    GBP total: <strong>${formatMoney(total)}</strong><br>
    Rate used: <strong>1 BTC = ${formatMoney(rate)}</strong><br>
    ${sourceText}
  `;
}

    // ============================================================
    // HELPERS
    // ============================================================

async function fetchLiveBtcPrice() {
  try {
    const response = await fetch(STORE_CONFIG.btcPriceApi, {
      method: "GET",
      headers: {
        "Accept": "application/json"
      }
    });

    if (!response.ok) {
      throw new Error(`BTC price fetch failed: ${response.status}`);
    }

    const data = await response.json();
    const amount = Number(data?.data?.amount);

    if (!Number.isFinite(amount) || amount <= 0) {
      throw new Error("Invalid BTC price response.");
    }

    liveBtcGbpRate = amount;
    liveBtcUpdatedAt = new Date();

    updateBtcEstimate();
    renderCart();

    showToast("Live BTC price loaded.");
  } catch (error) {
    console.warn(error);

    liveBtcGbpRate = null;
    liveBtcUpdatedAt = null;

    updateBtcEstimate();
    showToast("BTC price unavailable. Using fallback rate.");
  }
}


    function getProduct(id) {
      return STORE_CONFIG.products.find(product => product.id === id);
    }

    function getSubtotal() {
      return cart.reduce((sum, item) => {
        const product = getProduct(item.productId);
        return sum + (product ? product.price * item.qty : 0);
      }, 0);
    }

    function formatMoney(value) {
      return `${STORE_CONFIG.currencySymbol}${Number(value).toFixed(2)}`;
    }

    function formatVariants(variants = {}) {
      return Object.entries(variants)
        .filter(([, value]) => value)
        .map(([key, value]) => `${key}: ${value}`)
        .join(" / ");
    }

    function cartItemKey(productId, variants) {
      return `${productId}:${JSON.stringify(variants || {})}`;
    }

    function generateOrderNumber() {
      const date = new Date();
      const stamp = date.toISOString().slice(2, 10).replace(/-/g, "");
      const random = Math.random().toString(36).slice(2, 8).toUpperCase();
      return `${STORE_CONFIG.shopName.replace(/[^A-Z0-9]/gi, "").slice(0, 4).toUpperCase() || "SHOP"}-${stamp}-${random}`;
    }

    async function copyText(text, message) {
      try {
        await navigator.clipboard.writeText(text);
        showToast(message);
      } catch {
        const temp = document.createElement("textarea");
        temp.value = text;
        document.body.appendChild(temp);
        temp.select();
        document.execCommand("copy");
        temp.remove();
        showToast(message);
      }
    }

    function showToast(message) {
      els.toast.textContent = message;
      els.toast.classList.add("active");
      window.clearTimeout(showToast.timer);
      showToast.timer = window.setTimeout(() => els.toast.classList.remove("active"), 2200);
    }

    function slugify(value) {
      return String(value).toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
    }

    function escapeHtml(value) {
      return String(value)
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    function cssEscape(value) {
      if (window.CSS && CSS.escape) return CSS.escape(value);
      return String(value).replace(/[^a-zA-Z0-9_-]/g, "\\$&");
    }
  </script>
