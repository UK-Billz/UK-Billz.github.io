<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
  <meta name="referrer" content="no-referrer" />
  <title>UK Billz | 1:1 Notes</title>
  <style>
    /*
      MEMBERS-ONLY STATIC STOREFRONT
      ------------------------------------------------------------
      Edit the shop, products, shipping, BTC address, and access gate
      in the STORE_CONFIG object inside the <script> tag near the top
      of the JavaScript section.

      Static-site limitations:
      - This cannot securely verify BTC payments automatically.
      - This cannot securely store private customer/order data.
      - Link-only access is not real authentication.
      - The optional password gate is client-side only and not secure.
      - For a real private shop, use server-side authentication, order
        storage, and manual/API BTC payment verification.
    */

    :root {
      --bg: #05070a;
      --bg-2: #080c11;
      --panel: rgba(13, 18, 26, 0.78);
      --panel-strong: rgba(18, 24, 34, 0.92);
      --panel-soft: rgba(255, 255, 255, 0.035);
      --line: rgba(178, 219, 255, 0.16);
      --line-strong: rgba(178, 219, 255, 0.32);
      --text: #f2f7ff;
      --muted: #98a8ba;
      --muted-2: #657587;
      --accent: #7dd9ff;
      --accent-2: #b8edff;
      --danger: #ff7185;
      --success: #9cffd1;
      --warning: #ffe29a;
      --shadow: 0 24px 80px rgba(0, 0, 0, 0.48);
      --radius: 22px;
      --radius-sm: 14px;
      --max: 1180px;
      --font: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      --mono: "SFMono-Regular", Consolas, "Liberation Mono", Menlo, monospace;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: var(--font);
      background:
        radial-gradient(circle at 12% -10%, rgba(125, 217, 255, 0.16), transparent 28%),
        radial-gradient(circle at 88% 8%, rgba(142, 166, 255, 0.09), transparent 26%),
        linear-gradient(145deg, #020305 0%, #070b10 46%, #020407 100%);
      color: var(--text);
      min-height: 100vh;
      overflow-x: hidden;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(rgba(255,255,255,0.018) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.018) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.8), rgba(0,0,0,0.12));
      z-index: -2;
    }

    body::after {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(180deg, rgba(255,255,255,0.04), transparent 16%, transparent 84%, rgba(255,255,255,0.025));
      z-index: -1;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      border: 0;
      cursor: pointer;
    }

    img {
      max-width: 100%;
      display: block;
    }

    .shell {
      width: min(var(--max), calc(100% - 32px));
      margin-inline: auto;
    }

    .access-gate {
      position: fixed;
      inset: 0;
      display: none;
      place-items: center;
      background:
        radial-gradient(circle at center, rgba(125, 217, 255, 0.14), rgba(0, 0, 0, 0.92) 46%),
        #020305;
      z-index: 100;
      padding: 24px;
    }

    .access-gate.active {
      display: grid;
    }

    .gate-card {
      width: min(520px, 100%);
      border: 1px solid var(--line-strong);
      background: rgba(8, 12, 18, 0.82);
      box-shadow: var(--shadow);
      border-radius: 30px;
      padding: 28px;
      backdrop-filter: blur(20px);
    }

    .gate-lock {
      width: 54px;
      height: 54px;
      border-radius: 18px;
      display: grid;
      place-items: center;
      background: rgba(125, 217, 255, 0.1);
      border: 1px solid var(--line-strong);
      color: var(--accent);
      margin-bottom: 18px;
    }

    .gate-card h1 {
      margin: 0 0 10px;
      font-size: clamp(2rem, 8vw, 4rem);
      letter-spacing: -0.08em;
      line-height: 0.95;
    }

    .gate-card p {
      margin: 0 0 18px;
      color: var(--muted);
      line-height: 1.6;
    }

    .gate-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
    }

    .gate-error {
      color: var(--danger);
      min-height: 24px;
      margin-top: 10px;
      font-size: 0.9rem;
    }

    .topbar {
      position: sticky;
      top: 0;
      z-index: 50;
      backdrop-filter: blur(18px);
      background: rgba(3, 5, 8, 0.72);
      border-bottom: 1px solid rgba(178, 219, 255, 0.08);
    }

    .nav {
      height: 76px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      min-width: 0;
    }

    .brand-mark {
      width: 42px;
      height: 42px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      color: var(--accent-2);
      font-weight: 800;
      letter-spacing: -0.08em;
      background:
        linear-gradient(135deg, rgba(125, 217, 255, 0.18), rgba(255,255,255,0.04)),
        rgba(255,255,255,0.03);
      border: 1px solid var(--line-strong);
      box-shadow: inset 0 0 28px rgba(125, 217, 255, 0.08);
    }

    .brand-name {
      display: grid;
      gap: 1px;
    }

    .brand-name strong {
      font-size: 1rem;
      letter-spacing: 0.02em;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .brand-name span {
      font-family: var(--mono);
      color: var(--muted-2);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .nav-link,
    .ghost-btn,
    .primary-btn,
    .icon-btn,
    .danger-btn,
    .small-btn {
      border: 1px solid var(--line);
      color: var(--text);
      background: rgba(255,255,255,0.035);
      border-radius: 999px;
      padding: 11px 16px;
      transition: transform 180ms ease, border-color 180ms ease, background 180ms ease, box-shadow 180ms ease;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      white-space: nowrap;
    }

    .nav-link {
      color: var(--muted);
      font-size: 0.92rem;
    }

    .nav-link:hover,
    .ghost-btn:hover,
    .icon-btn:hover,
    .small-btn:hover {
      transform: translateY(-1px);
      border-color: var(--line-strong);
      background: rgba(125, 217, 255, 0.075);
    }

    .primary-btn {
      background: linear-gradient(135deg, rgba(125, 217, 255, 0.22), rgba(255,255,255,0.06));
      border-color: rgba(125, 217, 255, 0.42);
      color: #eafeff;
      box-shadow: 0 16px 40px rgba(125, 217, 255, 0.09);
      font-weight: 700;
    }

    .primary-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(125, 217, 255, 0.7);
      box-shadow: 0 18px 54px rgba(125, 217, 255, 0.14);
    }

    .danger-btn {
      color: #ffe6ea;
      border-color: rgba(255, 113, 133, 0.36);
      background: rgba(255, 113, 133, 0.08);
    }

    .small-btn {
      padding: 8px 11px;
      font-size: 0.84rem;
    }

    .cart-pill {
      position: relative;
    }

    .cart-count {
      min-width: 20px;
      height: 20px;
      padding-inline: 6px;
      border-radius: 999px;
      display: grid;
      place-items: center;
      background: var(--accent);
      color: #001018;
      font-size: 0.75rem;
      font-weight: 900;
    }

    .hero {
      padding: 72px 0 48px;
      display: grid;
      grid-template-columns: 1.12fr 0.88fr;
      gap: 32px;
      align-items: center;
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: var(--accent-2);
      border: 1px solid var(--line);
      background: rgba(125, 217, 255, 0.06);
      padding: 9px 12px;
      border-radius: 999px;
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      margin-bottom: 20px;
    }

    .pulse {
      width: 8px;
      height: 8px;
      border-radius: 99px;
      background: var(--success);
      box-shadow: 0 0 0 0 rgba(156, 255, 209, 0.62);
      animation: pulse 1.7s infinite;
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(156, 255, 209, 0.46); }
      70% { box-shadow: 0 0 0 8px rgba(156, 255, 209, 0); }
      100% { box-shadow: 0 0 0 0 rgba(156, 255, 209, 0); }
    }

    .hero h1 {
      margin: 0;
      font-size: clamp(3.2rem, 9vw, 7.8rem);
      line-height: 0.86;
      letter-spacing: -0.095em;
      max-width: 900px;
    }

    .hero .gradient-text {
      background: linear-gradient(135deg, #ffffff 8%, #b8edff 48%, #667583 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    .hero-copy {
      color: var(--muted);
      font-size: clamp(1rem, 2vw, 1.16rem);
      line-height: 1.75;
      max-width: 650px;
      margin: 24px 0 0;
    }

    .hero-actions {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-top: 28px;
    }

    .hero-card {
      position: relative;
      overflow: hidden;
      border: 1px solid var(--line);
      background: linear-gradient(180deg, rgba(255,255,255,0.08), rgba(255,255,255,0.025));
      border-radius: 34px;
      padding: 20px;
      box-shadow: var(--shadow);
      min-height: 500px;
      display: grid;
      align-content: space-between;
    }

    .hero-card::before {
      content: "";
      position: absolute;
      inset: -40%;
      background: conic-gradient(from 120deg, transparent, rgba(125,217,255,0.14), transparent 24%, transparent 70%, rgba(255,255,255,0.08));
      animation: rotate 16s linear infinite;
      opacity: 0.7;
    }

    .hero-card::after {
      content: "";
      position: absolute;
      inset: 1px;
      border-radius: 33px;
      background:
        radial-gradient(circle at 50% 24%, rgba(125, 217, 255, 0.22), transparent 28%),
        linear-gradient(180deg, rgba(12, 17, 24, 0.96), rgba(6, 9, 13, 0.96));
    }

    @keyframes rotate {
      to { transform: rotate(360deg); }
    }

    .hero-card > * {
      position: relative;
      z-index: 1;
    }

    .terminal-row {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      color: var(--muted-2);
      font-family: var(--mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .vault-display {
      margin: 44px auto 30px;
      width: min(320px, 100%);
      aspect-ratio: 1;
      border-radius: 42px;
      display: grid;
      place-items: center;
      border: 1px solid rgba(125, 217, 255, 0.25);
      background:
        linear-gradient(135deg, rgba(125, 217, 255, 0.13), rgba(255,255,255,0.03)),
        rgba(255,255,255,0.02);
      box-shadow:
        inset 0 0 90px rgba(125, 217, 255, 0.08),
        0 30px 80px rgba(0,0,0,0.35);
    }

    .vault-core {
      width: 58%;
      aspect-ratio: 1;
      border-radius: 50%;
      border: 1px solid rgba(184, 237, 255, 0.35);
      display: grid;
      place-items: center;
      background: radial-gradient(circle, rgba(125,217,255,0.18), rgba(255,255,255,0.025) 58%, rgba(0,0,0,0.2));
      box-shadow: inset 0 0 40px rgba(125,217,255,0.08);
    }

    .vault-core span {
      font-family: var(--mono);
      font-size: 0.8rem;
      color: var(--accent-2);
      letter-spacing: 0.18em;
    }

    .stat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
    }

    .stat {
      border: 1px solid var(--line);
      border-radius: 18px;
      padding: 14px;
      background: rgba(255,255,255,0.035);
    }

    .stat strong {
      display: block;
      font-size: 1.2rem;
      letter-spacing: -0.04em;
    }

    .stat span {
      display: block;
      margin-top: 4px;
      font-family: var(--mono);
      color: var(--muted-2);
      font-size: 0.68rem;
      text-transform: uppercase;
    }

    .section {
      padding: 54px 0;
    }

    .section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 22px;
    }

    .section-kicker {
      color: var(--accent);
      font-family: var(--mono);
      font-size: 0.75rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      margin-bottom: 10px;
    }

    .section h2 {
      margin: 0;
      font-size: clamp(2rem, 5vw, 4.2rem);
      line-height: 0.96;
      letter-spacing: -0.075em;
    }

    .section-desc {
      color: var(--muted);
      line-height: 1.7;
      max-width: 560px;
      margin: 0;
    }

    .filter-row {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      margin-bottom: 24px;
    }

    .search-box {
      flex: 1 1 260px;
      min-width: 0;
    }

    .input,
    .select,
    .textarea {
      width: 100%;
      border: 1px solid var(--line);
      color: var(--text);
      background: rgba(255,255,255,0.035);
      border-radius: 16px;
      padding: 13px 14px;
      outline: none;
      transition: border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;
    }

    .textarea {
      min-height: 100px;
      resize: vertical;
    }

    .input:focus,
    .select:focus,
    .textarea:focus {
      border-color: rgba(125,217,255,0.58);
      box-shadow: 0 0 0 4px rgba(125,217,255,0.08);
      background: rgba(255,255,255,0.055);
    }

    .select option {
      background: #0b1017;
      color: var(--text);
    }

    .product-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }

    .product-card,
    .info-card,
    .checkout-panel,
    .policy-card {
      border: 1px solid var(--line);
      background: var(--panel);
      border-radius: var(--radius);
      box-shadow: 0 18px 60px rgba(0,0,0,0.18);
      backdrop-filter: blur(16px);
    }

    .product-card {
      overflow: hidden;
      transition: transform 200ms ease, border-color 200ms ease, background 200ms ease;
    }

    .product-card:hover {
      transform: translateY(-4px);
      border-color: rgba(125,217,255,0.42);
      background: rgba(16, 22, 31, 0.86);
    }

    .product-media {
      position: relative;
      aspect-ratio: 1.08;
      display: grid;
      place-items: center;
      background:
        radial-gradient(circle at 50% 32%, rgba(125,217,255,0.17), transparent 36%),
        linear-gradient(145deg, rgba(255,255,255,0.05), rgba(255,255,255,0.015));
      border-bottom: 1px solid var(--line);
      overflow: hidden;
    }

    .product-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.85;
    }

    .placeholder-orb {
      width: 48%;
      aspect-ratio: 1;
      border-radius: 32px;
      border: 1px solid rgba(125,217,255,0.28);
      background:
        linear-gradient(135deg, rgba(125,217,255,0.16), rgba(255,255,255,0.04)),
        rgba(255,255,255,0.02);
      box-shadow: inset 0 0 80px rgba(125,217,255,0.08);
      display: grid;
      place-items: center;
      font-family: var(--mono);
      color: var(--accent-2);
      letter-spacing: 0.12em;
      font-size: 0.75rem;
      text-transform: uppercase;
    }

    .stock-badge,
    .feature-badge {
      position: absolute;
      top: 14px;
      left: 14px;
      border: 1px solid var(--line);
      background: rgba(4, 7, 11, 0.74);
      color: var(--success);
      border-radius: 999px;
      padding: 7px 10px;
      font-size: 0.75rem;
      font-family: var(--mono);
      backdrop-filter: blur(14px);
    }

    .feature-badge {
      left: auto;
      right: 14px;
      color: var(--accent-2);
    }

    .product-body {
      padding: 18px;
    }

    .product-top {
      display: flex;
      justify-content: space-between;
      gap: 14px;
      align-items: start;
      margin-bottom: 9px;
    }

    .product-title {
      margin: 0;
      font-size: 1.08rem;
      letter-spacing: -0.03em;
    }

    .price {
      color: var(--accent-2);
      font-weight: 800;
      white-space: nowrap;
    }

    .product-desc {
      color: var(--muted);
      line-height: 1.55;
      margin: 0 0 14px;
      min-height: 50px;
    }

    .variant-row,
    .qty-row {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      align-items: center;
      margin-top: 10px;
    }

    .qty-control {
      display: inline-grid;
      grid-template-columns: 34px 42px 34px;
      border: 1px solid var(--line);
      border-radius: 999px;
      overflow: hidden;
      background: rgba(255,255,255,0.03);
    }

    .qty-control button,
    .qty-control span {
      height: 34px;
      display: grid;
      place-items: center;
      color: var(--text);
      background: transparent;
      border-right: 1px solid var(--line);
      font-size: 0.9rem;
    }

    .qty-control button:last-child,
    .qty-control span:last-child {
      border-right: 0;
    }

    .product-actions {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 10px;
      margin-top: 16px;
    }

    .info-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    .info-card {
      padding: 18px;
    }

    .info-card .icon {
      width: 40px;
      height: 40px;
      border-radius: 15px;
      display: grid;
      place-items: center;
      background: rgba(125,217,255,0.08);
      border: 1px solid var(--line);
      color: var(--accent-2);
      margin-bottom: 18px;
    }

    .info-card h3,
    .policy-card h3 {
      margin: 0 0 8px;
      letter-spacing: -0.035em;
    }

    .info-card p,
    .policy-card p,
    .policy-card li {
      margin: 0;
      color: var(--muted);
      line-height: 1.65;
    }

    .drawer {
      position: fixed;
      inset: 0;
      z-index: 70;
      pointer-events: none;
    }

    .drawer.active {
      pointer-events: auto;
    }

    .drawer-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.62);
      opacity: 0;
      transition: opacity 220ms ease;
    }

    .drawer.active .drawer-backdrop {
      opacity: 1;
    }

    .drawer-panel {
      position: absolute;
      top: 0;
      right: 0;
      width: min(510px, 100%);
      height: 100%;
      background:
        linear-gradient(180deg, rgba(16,22,31,0.98), rgba(5,7,10,0.98));
      border-left: 1px solid var(--line-strong);
      box-shadow: -30px 0 100px rgba(0,0,0,0.45);
      transform: translateX(100%);
      transition: transform 260ms ease;
      display: grid;
      grid-template-rows: auto 1fr auto;
    }

    .drawer.active .drawer-panel {
      transform: translateX(0);
    }

    .drawer-head,
    .drawer-foot {
      padding: 18px;
      border-bottom: 1px solid var(--line);
    }

    .drawer-foot {
      border-bottom: 0;
      border-top: 1px solid var(--line);
      display: grid;
      gap: 12px;
    }

    .drawer-head {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
    }

    .drawer-head h2 {
      margin: 0;
      letter-spacing: -0.05em;
    }

    .cart-items {
      padding: 18px;
      overflow: auto;
      display: grid;
      align-content: start;
      gap: 12px;
    }

    .cart-empty {
      border: 1px dashed var(--line-strong);
      border-radius: var(--radius);
      padding: 26px;
      color: var(--muted);
      line-height: 1.6;
      text-align: center;
    }

    .cart-item {
      display: grid;
      grid-template-columns: 72px 1fr;
      gap: 12px;
      border: 1px solid var(--line);
      border-radius: 18px;
      background: rgba(255,255,255,0.035);
      padding: 12px;
    }

    .cart-thumb {
      border-radius: 15px;
      background: rgba(125,217,255,0.08);
      border: 1px solid var(--line);
      display: grid;
      place-items: center;
      overflow: hidden;
      aspect-ratio: 1;
      font-family: var(--mono);
      color: var(--accent-2);
      font-size: 0.62rem;
    }

    .cart-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .cart-meta {
      min-width: 0;
    }

    .cart-meta h4 {
      margin: 0 0 4px;
      font-size: 0.96rem;
      letter-spacing: -0.02em;
    }

    .cart-meta p {
      margin: 0 0 10px;
      color: var(--muted-2);
      font-size: 0.84rem;
    }

